# ---------------------------------------------------------------------------
# Routing
#
# This is a client-rendered SPA, so the real pages only exist inside the
# browser. The server therefore has to know which URLs are real. Previously
# every unknown URL was rewritten to /index.html, which made the server answer
# 200 for URLs that do not exist (soft 404s). Now only the routes listed in
# src/App.jsx are handed to index.html; everything else gets a real 404.
#
# When a route is added to src/App.jsx, add it to the list in step 4 below.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. One canonical host: www -> non-www, always over https, in a single hop.
  #    (http -> https for the bare domain is already enforced by the host, so
  #    no separate https rule is added here to avoid any chance of a loop.)
  RewriteCond %{HTTP_HOST} ^www\.vectraforeignservices\.com$ [NC]
  RewriteRule ^(.*)$ https://vectraforeignservices.com/$1 [R=301,L]

  # 2. /index.html is just "/".
  RewriteCond %{THE_REQUEST} \s/index\.html[?\s] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 3. No trailing slash: /about/ -> /about. Real directories are left alone.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Serving index.html itself (also used by ErrorDocument below): stop here.
  RewriteRule ^index\.html$ - [L]

  # 4. Known SPA routes -> index.html. Real files/directories (assets, images,
  #    send_mail.php, ielts-mock-test.html, ...) are never rewritten.
  #    Routes are matched case-sensitively and in lowercase, as linked.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule ^(about|services|resources|contact|check-eligibility|thank-you|terms-of-service|compliance|cookie-policy|mock-tests|mock-tests/(attempt|result)/[^/]+|admin/login|admin/mock-tests|country/(canada|usa|australia|uk|europe|nz|uae))$ /index.html [L]

  # Anything else is not rewritten, so the server answers 404 on its own.
</IfModule>

# The 404 response body is the app shell, so a visitor who mistypes a URL sees
# the site's own "page not found" screen (rendered by the router) instead of a
# bare server error. The HTTP status stays a genuine 404.
ErrorDocument 404 /index.html

# Compression. Left to mod_deflate on purpose: serving the pre-built .gz files
# instead needs mod_rewrite and mod_headers to both be enabled, and if only the
# first one is, Apache hands the browser gzipped bytes with no Content-Encoding
# and every page breaks. Not worth the risk for bytes mod_deflate already saves.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Caching. Matched by extension rather than by an <If> block on /assets/, so it
# also works on Apache 2.2.
<IfModule mod_headers.c>
  # Every .js/.css in this build is content-hashed by Vite, so a change always
  # produces a new filename and these can be cached indefinitely.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images, video and audio keep stable filenames, so they get a week instead.
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico|mp4|webm|mp3|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # HTML must always revalidate, otherwise a redeploy would not reach anyone
  # still holding a cached copy.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
